{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Minimal user profile linked to a Firebase Auth account without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9._\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "createdAt", "updatedAt"]
    },
    "GamePlan": {
      "title": "GamePlan",
      "description": "Basketball half-time rotation plan owned by a single user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "players": {
          "type": "array",
          "description": "Roster list of players (max 40)."
        },
        "lineups": {
          "type": "object",
          "description": "Lineups for Starting, Transition1, Second, Transition2, and Finish."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "players", "lineups", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document keyed by Firebase Auth UID."
    },
    "/users/{userId}/plans/{planId}": {
      "schema": { "$ref": "#/entities/GamePlan" },
      "description": "Rotation plans belonging to the user."
    }
  }
}
